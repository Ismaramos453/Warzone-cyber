{
  "name": "warzone-cyber-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lab:xss": "node --watch labs/xss-reflejado/server.js",
