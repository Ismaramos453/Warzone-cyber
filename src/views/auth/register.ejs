<%- include('../partials/header') %><section class="auth"><p class="eyebrow">NUEVO OPERADOR</p><h1>Crea tu cuenta</h1><p>Utiliza tu correo académico si tu centro así lo requiere.</p><% if (error) { %><p class="alert error"><%= error %></p><% } %><form method="post" class="card"><label>Nombre<input name="name" required maxlength="80"></label><label>Correo<input type="email" name="email" required autocomplete="email"></label><label>Contraseña<input type="password" name="password" required minlength="10" autocomplete="new-password"></label><button class="primary">Crear cuenta</button></form><p>¿Ya tienes cuenta? <a href="/acceso">Accede</a></p></section><%- include('../partials/footer') %>
