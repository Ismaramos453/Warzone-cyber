<%- include('../partials/header') %><a class="back-link" href="/retos">← Volver a retos</a><section class="detail accent-<%= challenge.presentation.accent %>"><div class="detail-heading"><span class="detail-icon"><%= challenge.presentation.icon === 'code' ? '</>' : challenge.presentation.icon === 'database' ? '▣' : '◈' %></span><div><p class="eyebrow"><%= challenge.presentation.label %></p><h1><%= challenge.title %></h1></div></div><div class="mission-grid"><article><p class="brief-label">SITUACIÓN</p><p><%= challenge.presentation.mission %></p></article><article><p class="brief-label">OBJETIVO</p><p><%= challenge.presentation.objective %></p></article></div><div class="mission-stats"><span>◆ <%= challenge.difficulty %></span><span>⚡ <%= challenge.points %> XP</span><span><%= challenge.solved ? '✓ Completado' : '○ Sin completar' %></span></div><a class="primary button" href="<%= challenge.lab_url %>" target="_blank" rel="noopener noreferrer">Abrir laboratorio <b>↗</b></a><div class="hint"><span>?</span><p><strong>Pista de analista</strong><br><%= challenge.presentation.hint %></p></div><hr><h2>Validar hallazgo</h2><p class="muted">Envía la flag obtenida en el laboratorio para registrar la misión.</p><% if (result) { %><p class="alert <%= result.status === 'correct' ? 'success' : 'error' %>"><% if (result.status === 'correct') { %>¡Misión completada! Has obtenido <%= result.points %> XP.<% } else if (result.status === 'already-solved') { %>Ya habías completado esta misión.<% } else { %>La flag no es correcta. Sigue investigando.<% } %></p><% } %><% if (!challenge.solved) { %><form class="flag-form" method="post" action="/retos/<%= challenge.slug %>/flag"><label>FLAG<input name="flag" required placeholder="flag{...}" autocomplete="off"></label><button class="primary">Validar flag <b>→</b></button></form><% } %></section><%- include('../partials/footer') %>
