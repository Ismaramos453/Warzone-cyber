<%- include('partials/header') %><section class="hero"><div><p class="eyebrow">PANEL DE OPERACIONES</p><h1>Hola, <span><%= user.name %></span>.</h1><p>Elige tu próximo vector de ataque. Cada misión se puede completar en cualquier orden.</p><a class="primary button" href="/retos">Explorar retos <b>→</b></a></div><div class="score"><span class="score-icon">⌁</span><strong><%= solved %>/<%= challenges.length %></strong><small>retos resueltos</small><div class="progress"><i style="width:<%= challenges.length ? (solved / challenges.length) * 100 : 0 %>%"></i></div></div></section><section><div class="section-heading"><div><p class="eyebrow">MISIÓN DISPONIBLE</p><h2>Tu zona de entrenamiento</h2></div><a href="/retos">Ver todos →</a></div><div class="grid"><% challenges.forEach((challenge) => { %><article class="card challenge accent-<%= challenge.presentation.accent %>"><div class="challenge-top"><span class="challenge-icon"><%= challenge.presentation.icon === 'code' ? '</>' : challenge.presentation.icon === 'database' ? '▣' : '◈' %></span><span class="points"><%= challenge.points %> XP</span></div><p class="tag"><%= challenge.presentation.label %></p><h3><%= challenge.title %></h3><p><%= challenge.presentation.mission %></p><div class="challenge-meta"><span><%= challenge.difficulty %></span><span class="solved"><%= challenge.solved ? '✓ Completado' : '○ Pendiente' %></span></div><a class="card-link" href="/retos/<%= challenge.slug %>"><%= challenge.solved ? 'Revisar misión' : 'Iniciar misión' %> <b>→</b></a></article><% }) %></div></section><%- include('partials/footer') %>
